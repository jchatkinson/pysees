{
  "name": "pysees",
  "private": true,
  "version": "0.3.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "wasm": "bash scripts/build-carapace.sh",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "schema:extract": "uv run python scripts/generate_opensees_schemas.py",
    "schema:build": "uv run python scripts/build_runtime_schemas.py",
    "schema:check": "uv run python scripts/build_runtime_schemas.py --output .schema-check.ts >/dev/null && diff -q .schema-check.ts src/app/generated/commandSchemas.generated.ts; rc=$?; rm -f .schema-check.ts; exit $rc"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@clerk/clerk-react": "^5.46.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/roboto": "^5.2.10",
    "@fontsource-variable/roboto-slab": "^5.3.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tailwindcss/vite": "^4.1.17",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.41.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.6.5",
    "react-router-dom": "^7.9.6",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.17",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "shadcn": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.2.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "@clerk/shared@3.47.8": true
  }
}
